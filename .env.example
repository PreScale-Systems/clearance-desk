# Google AI — Gemini via google-genai / google-adk
# Either use an API key (AI Studio) ...
GOOGLE_API_KEY=
# ... or Vertex AI (recommended on Cloud Run)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Parallel Web Systems — Search API
PARALLEL_API_KEY=

# Models
EXTRACT_MODEL=gemini-2.5-pro
JUDGE_MODEL=gemini-2.5-flash
REPORT_MODEL=gemini-2.5-pro

# Persistence: memory (default) or firestore
STORE=memory
FIRESTORE_COLLECTION=clearance_jobs

# Max items researched per job (cost guard)
MAX_ITEMS=120
